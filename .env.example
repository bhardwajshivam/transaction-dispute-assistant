# Optional local model configuration. This file is NOT automatically loaded.
# Export these variables in your launch terminal. No API key is required.
EVIDENCE_PROPOSER_MODE=deterministic
OLLAMA_MODEL=smollm2:135m
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_OUTPUT_TOKENS=256

# Local description extraction is attempted by default; validated parser/guided fallback applies.
# Set deterministic explicitly for offline operation.
CONCERN_EXTRACTION_MODE=ollama

# Privacy settings (defaults are active without configuring these).
# Optionally use an externally managed Fernet key instead of the local .private key.
# CONCERN_ENCRYPTION_KEY=managed-secret-value
# Staff workspace is locked until a high-entropy token hash is configured.
# Generate the hash with: python scripts/staff_token_hash.py
# STAFF_ACCESS_TOKEN_SHA256=64-character-hash
STAFF_ALLOWED_CUSTOMERS=C-001
SHOW_INTERNAL_DEBUG=0
